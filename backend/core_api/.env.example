DATABASE_URL=sqlite:///./prajapulse.db
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AI_SERVICE_URL=http://localhost:8001
AI_TIMEOUT_SECONDS=120
AI_PROXY_REQUIRE_AUTH=false
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
CORS_ORIGINS=*
DAILY_POINTS_CAP=60
# Calendar day used for the daily points cap (IANA name)
DAY_RESET_TZ=Asia/Kolkata

# Report quality rules (photo, description length, location, duplicate check) and a per-user daily limit
STRICT_REPORT_RULES=true
MAX_REPORTS_PER_DAY=10

# NGO accounts publish contests. Share this code only with verified NGOs (empty = NGO sign-up closed)
NGO_SIGNUP_CODE=
